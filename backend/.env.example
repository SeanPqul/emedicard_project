# Backend Environment Variables

# Clerk Webhook Secret
CLERK_WEBHOOK_SECRET=whsec_your-clerk-webhook-secret-here

# Clerk Backend Secret Key
CLERK_SECRET_KEY=sk_your-clerk-secret-key

# Clerk JWT Issuer Domain (for webadmin)
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-frontend-api.clerk.accounts.dev

# Expo Clerk Frontend API URL (for mobile)
EXPO_CLERK_FRONTEND_API_URL=https://your-clerk-frontend-api.clerk.accounts.dev

# Maya Payment Gateway Configuration
# Sandbox credentials - replace with production credentials when going live
MAYA_PUBLIC_KEY=pk-your-maya-public-key
MAYA_SECRET_KEY=sk-your-maya-secret-key
MAYA_API_URL=https://pg-sandbox.paymaya.com
MAYA_WEBHOOK_SECRET=whsec_your-maya-webhook-secret-here

# Convex public site URL
CONVEX_URL=https://your-convex-site.convex.site

# Application URLs for Maya redirects
APP_URL=http://localhost:3000
MOBILE_APP_URL=exp://localhost:8081

# Maya Webhook URL (uses Convex public endpoint)
WEBHOOK_URL=https://your-convex-site.convex.site/maya-webhook

# Document Access Security
# Secret key for HMAC-signing secure document URLs
DOCUMENT_SIGNING_SECRET=your-random-document-signing-secret
