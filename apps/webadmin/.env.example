# Web Admin Environment Variables

# Convex Backend URL
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# Convex deployment identifier
CONVEX_DEPLOYMENT=your-convex-deployment-name

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=sk_your-clerk-secret-key
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-frontend-api.clerk.accounts.dev
CLERK_WEBHOOK_SECRET=whsec_your-clerk-webhook-secret

# OCR service endpoint
OCR_SERVICE_URL=http://localhost:5001

# Optional bundle analysis
ANALYZE=false
