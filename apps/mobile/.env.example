# Expo Public Environment Variables

# Convex Backend URL
EXPO_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# Clerk Authentication
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Public verification page base URL
EXPO_PUBLIC_VERIFICATION_URL=https://your-webadmin-domain.example.com

# Optional Clerk frontend API URL
EXPO_CLERK_FRONTEND_API_URL=https://your-clerk-frontend-api.clerk.accounts.dev
